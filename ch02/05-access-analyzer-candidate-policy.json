{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteScopedOrderObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::orderflow-assets-111122223333/orders/*"
    },
    {
      "Sid": "ReadScopedOrderDbSecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:111122223333:secret:orderflow/*"
      ]
    },
    {
      "Sid": "OverBroadS3WildcardViolation",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": "*"
    },
    {
      "Sid": "UnscopedIamPassRoleViolation",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "*"
    }
  ]
}
